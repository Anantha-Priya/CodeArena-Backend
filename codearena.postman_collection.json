        {
          "name": "Login Non-Participant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{nonParticipantEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Login succeeds with 200 and a token', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().token).to.be.a('string').and.not.empty;",
              "});",
              "pm.collectionVariables.set('nonParticipantToken', pm.response.json().token);"
            ]}
          }]
        }
      ]
    },
