{
  "info": {
    "name": "CodeArena API",
    "description": "Regression collection for the CodeArena API. Run folders top-to-bottom (Auth -> Problems -> Contests -> Contest Participation -> Submissions -> Leaderboard) - later requests depend on ids/tokens captured by earlier ones via collection variables.\n\nIMPORTANT - one manual step: this API has no admin-creation endpoint (v1 scope). After running \"Auth > Register Admin\" once, promote that user before running the Problems/Contests admin requests:\n\nUPDATE users SET role='ADMIN' WHERE email='postman_admin@codearena.com';\n\nAssumes the app is running locally on the default port (baseUrl below) and codearena_db has no conflicting data from a previous run - re-registering the same email/username will 409.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "password", "value": "Passw0rd!" },
    { "key": "adminUsername", "value": "postman_admin" },
    { "key": "adminEmail", "value": "postman_admin@codearena.com" },
    { "key": "userUsername", "value": "postman_user" },
    { "key": "userEmail", "value": "postman_user@codearena.com" },
    { "key": "nonParticipantUsername", "value": "postman_nonparticipant" },
    { "key": "nonParticipantEmail", "value": "postman_nonparticipant@codearena.com" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "nonParticipantToken", "value": "" },
    { "key": "problemId", "value": "" },
    { "key": "unassociatedProblemId", "value": "" },
    { "key": "problemToDeleteId", "value": "" },
    { "key": "contestActiveId", "value": "" },
    { "key": "contestUpcomingId", "value": "" },
    { "key": "contestEndedId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Register succeeds with 201', function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ]}
          }]
        },
        {
          "name": "Register - Duplicate Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"someone_else\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Duplicate email is rejected with 409', function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "pm.test('Body explains the conflict', function () {",
              "    pm.expect(pm.response.json().message).to.include('Email');",
              "});"
            ]}
          }]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Login succeeds with 200 and a token', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().token).to.be.a('string').and.not.empty;",
              "});",
              "pm.collectionVariables.set('adminToken', pm.response.json().token);"
            ]}
          }]
        },
        {
          "name": "Login - Invalid Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"WrongPassword!\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Wrong password is rejected with 401', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]}
          }]
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userUsername}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
