          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Leaderboard has 2 participants ranked correctly by score', function () {",
              "    pm.response.to.have.status(200);",
              "    const entries = pm.response.json();",
              "    pm.expect(entries.length).to.be.at.least(2);",
              "    pm.expect(entries[0].rank).to.eql(1);",
              "    pm.expect(entries[0].username).to.eql(pm.collectionVariables.get('userUsername'));",
              "    pm.expect(entries[0].score).to.eql(200);",
              "    pm.expect(entries[1].rank).to.eql(2);",
              "    pm.expect(entries[1].score).to.eql(0);",
              "    for (let i = 1; i < entries.length; i++) {",
              "        pm.expect(entries[i].score).to.be.at.most(entries[i - 1].score);",
              "    }",
              "});"
            ]}
          }]
        }
